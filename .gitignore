
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#080b20">
<title>توقع جنس المولود 💗</title>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800;900&display=swap" rel="stylesheet">

<style>
*{
box-sizing:border-box;
-webkit-tap-highlight-color:transparent;
}

html,body{
margin:0;
width:100%;
min-height:100%;
overflow-x:hidden;
}

body{
background:#080b20;
color:white;
font-family:Cairo,sans-serif;
}

button,input{
font-family:inherit;
}

.scene{
min-height:100vh;
min-height:100svh;
position:relative;
overflow:hidden;
background:
radial-gradient(ellipse at 8% 54%,#203b80 0%,transparent 37%),
radial-gradient(ellipse at 94% 55%,#632458 0%,transparent 38%),
linear-gradient(135deg,#05081b,#10132d 52%,#08091c);
}

.stars{
position:absolute;
inset:0;
pointer-events:none;
background-image:
radial-gradient(#fff 1px,transparent 1.5px),
radial-gradient(#91baff 1.2px,transparent 1.7px),
radial-gradient(#f3a4df 1px,transparent 1.5px);
background-size:83px 83px,137px 137px,191px 191px;
animation:stars 45s linear infinite;
}

@keyframes stars{
to{background-position:93px 103px,182px 217px,281px 221px}
}

header{
height:90px;
padding:15px 4%;
display:flex;
align-items:center;
justify-content:flex-start;
position:relative;
z-index:10;
}

.logo{
position:absolute;
left:50%;
top:5px;
transform:translateX(-50%);
font-size:58px;
}

nav button{
color:white;
background:linear-gradient(135deg,#27274f,#302044);
border:1px solid #7865a8;
border-radius:35px;
padding:10px 22px;
font-size:16px;
cursor:pointer;
}

.hero{
text-align:center;
padding:12px 18px 190px;
position:relative;
z-index:4;
}

h1{
font-size:clamp(38px,5.5vw,76px);
font-weight:900;
margin:5px 0;
background:linear-gradient(90deg,#a5caff,#e9d6ff,#f5a0db);
-webkit-background-clip:text;
background-clip:text;
color:transparent;
animation:glow 4s infinite alternate;
}

@keyframes glow{
to{filter:drop-shadow(0 0 22px #ef9bda)}
}

.subtitle{
color:#e5dafa;
font-size:clamp(18px,2.3vw,28px);
}

.underline{
width:240px;
height:8px;
margin:15px auto 25px;
border-top:4px solid #ee8ed0;
border-radius:50%;
}

.form-card{
width:min(745px,94%);
margin:auto;
padding:30px;
border-radius:40px;
border:2px solid transparent;
background:
linear-gradient(135deg,#202b55ee,#32203f) padding-box,
linear-gradient(110deg,#7bc0ff,#aa8bf5,#f18dce) border-box;
box-shadow:0 0 28px #80baff55,0 0 45px #eb8fca33;
backdrop-filter:blur(14px);
animation:float 5s ease-in-out infinite;
}

@keyframes float{
50%{transform:translateY(-5px)}
}

label{
display:block;
font-size:24px;
font-weight:800;
margin-bottom:12px;
}

.name{
width:100%;
height:65px;
color:white;
background:#ffffff0b;
border:2px solid #696291;
border-radius:55px;
outline:none;
font-size:20px;
padding:0 20px;
text-align:center;
}

.name::placeholder{
color:#c5bbda;
}

.name:focus{
border-color:#8cc6ff;
box-shadow:0 0 20px #78baff88;
}

.choice-title{
font-size:25px;
margin:20px 0 15px;
}

.choices{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
}

.choice{
min-height:90px;
border-radius:30px;
background:#ffffff0b;
font-size:25px;
font-weight:900;
cursor:pointer;
transition:all .25s ease;
position:relative;
overflow:hidden;
}

.choice .emoji{
font-size:36px;
margin-left:8px;
}

.boy{
color:#9acbff;
border:2px solid #7bbaff;
}

.girl{
color:#f4a5d9;
border:2px solid #ed91d0;
}

/* تحديد الولد */
.boy.selected{
background:linear-gradient(135deg,#367dcc88,#5a9fff66);
border:3px solid #8dccff;
box-shadow:
0 0 12px #6ebaff,
0 0 30px #6ebaffaa,
inset 0 0 15px #6ebaff44;
transform:scale(1.04) translateY(-4px);
}

/* تحديد البنت */
.girl.selected{
background:linear-gradient(135deg,#d94da588,#e77bc966);
border:3px solid #ffb4e5;
box-shadow:
0 0 12px #ef8dcb,
0 0 30px #ef8dcb99,
inset 0 0 15px #ef8dcb44;
transform:scale(1.04) translateY(-4px);
}

/* دائرة الاختيار */
.choice .circle{
display:inline-flex;
align-items:center;
justify-content:center;
width:27px;
height:27px;
border:2px solid currentColor;
border-radius:50%;
font-size:17px;
margin-right:5px;
vertical-align:middle;
transition:.25s;
}

.choice.selected .circle{
background:currentColor;
color:#17203d;
border-color:currentColor;
}

.choice.selected .circle::after{
content:"✓";
font-weight:900;
}

.send{
width:100%;
margin-top:24px;
height:75px;
border:0;
border-radius:55px;
background:linear-gradient(105deg,#88d0ff,#a48cf1,#f28bc8);
color:white;
font-size:23px;
font-weight:900;
cursor:pointer;
transition:.3s;
}

.send:hover{
transform:scale(1.025);
box-shadow:0 0 32px #dd9bff99;
}

.hint{
margin-top:18px;
color:#d6c9ec;
font-size:14px;
}

/* علامات الاستفهام */
.question{
position:absolute;
top:125px;
z-index:2;
font-size:clamp(75px,12vw,145px);
font-weight:900;
line-height:1;
pointer-events:none;
animation:questionFloat 4s ease-in-out infinite;
}

.question.blue{
left:7%;
color:#a4caff;
text-shadow:0 0 15px #72aaff,0 0 40px #518affaa;
}

.question.pink{
right:7%;
color:#f5a4dc;
text-shadow:0 0 15px #f28bda,0 0 40px #e85bbbaa;
animation-delay:1.5s;
}

@keyframes questionFloat{
0%,100%{transform:translateY(0) rotate(-5deg)}
50%{transform:translateY(-20px) rotate(5deg)}
}

/* القلوب والتيجان */
.doodle{
position:absolute;
font-size:52px;
z-index:2;
text-shadow:0 0 17px currentColor;
animation:doodle 3.5s ease-in-out infinite;
pointer-events:none;
}

.doodle.blue{color:#69bdff}
.doodle.pink{color:#f18ecf}

.heart-left{left:19%;top:29%}
.heart-right{right:19%;top:29%}
.crown-left{left:20%;top:23%}
.crown-right{right:20%;top:23%}

@keyframes doodle{
50%{transform:translateY(-9px) rotate(5deg)}
}

/* الإيموجيات السفلية */
.corner-symbol{
position:absolute;
z-index:5;
bottom:180px;
width:clamp(76px,10vw,145px);
text-align:center;
font-size:clamp(72px,9vw,128px);
line-height:1;
filter:drop-shadow(0 10px 16px #0008);
pointer-events:none;
animation:symbol 3.8s ease-in-out infinite;
}

.boy-symbol{left:6%}
.girl-symbol{right:6%;animation-delay:1s}

@keyframes symbol{
50%{transform:translateY(-13px) rotate(4deg)}
}

/* السحب */
.cloud-bank{
position:absolute;
height:145px;
bottom:-45px;
left:-5%;
width:110%;
z-index:4;
background:linear-gradient(180deg,#b5c5ff,#899fe9 65%,#6679cb);
border-radius:50% 50% 0 0;
box-shadow:0 -12px 35px #a3b8ff55;
animation:cloudmove 8s ease-in-out infinite alternate;
}

.cloud-bank:before,.cloud-bank:after{
content:"";
position:absolute;
width:280px;
height:190px;
border-radius:50%;
top:-80px;
}

.cloud-bank:before{
left:8%;
background:linear-gradient(140deg,#dfe8ff,#8da7f3);
}

.cloud-bank:after{
right:8%;
background:linear-gradient(140deg,#ffe0f8,#d68dd2);
}

@keyframes cloudmove{
to{transform:translateX(25px)}
}

.cloud{
position:absolute;
width:180px;
height:100px;
border-radius:100px;
bottom:35px;
z-index:4;
background:linear-gradient(145deg,#e2eaff,#94acf2);
}

.cloud:before,.cloud:after{
content:"";
position:absolute;
background:inherit;
border-radius:50%;
}

.cloud:before{
width:100px;
height:100px;
top:-45px;
left:25px;
}

.cloud:after{
width:120px;
height:120px;
top:-55px;
right:15px;
}

.cloud.left{left:-50px}
.cloud.right{
right:-50px;
background:linear-gradient(145deg,#ffdef4,#d38acf);
}

/* صفحة النتائج */
.results{
position:fixed;
z-index:30;
inset:0;
display:none;
overflow:auto;
padding:20px;
background:
radial-gradient(ellipse at 10% 30%,#24407d,transparent 42%),
radial-gradient(ellipse at 90% 30%,#64285e,transparent 42%),
#080b20;
}

.results-box{
width:min(780px,100%);
margin:25px auto;
padding:30px;
border:2px solid transparent;
border-radius:32px;
background:
linear-gradient(135deg,#202b55,#33213f) padding-box,
linear-gradient(120deg,#7bbaff,#ae8bf5,#f18dc9) border-box;
box-shadow:0 0 35px #93aaff44;
}

.back{
padding:10px 20px;
background:#ffffff12;
border:1px solid #a68dd2;
color:white;
border-radius:25px;
cursor:pointer;
}

.results h2{
text-align:center;
font-size:34px;
color:#efa0d6;
}

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
margin:25px 0;
}

.stat{
border:1px solid #ffffff30;
background:#ffffff0b;
border-radius:20px;
padding:13px;
text-align:center;
}

.stat strong{
display:block;
font-size:28px;
}

.list{
max-height:45vh;
overflow:auto;
}

.vote{
display:flex;
justify-content:space-between;
gap:12px;
padding:13px 5px;
border-bottom:1px solid #ffffff20;
}

.empty{
text-align:center;
padding:25px;
color:#d2c7e8;
}

.toast{
position:fixed;
z-index:50;
bottom:25px;
left:50%;
transform:translateX(-50%);
display:none;
max-width:90%;
border:1px solid #b59af5;
background:#292448;
padding:13px 22px;
border-radius:30px;
text-align:center;
}

/* إعدادات الجوال */
@media screen and (max-width:600px){

header{
height:65px;
padding:8px 12px;
}

.logo{
display:none;
}

nav button{
padding:7px 14px;
font-size:13px;
}

.hero{
padding:75px 12px 145px;
}

h1{
font-size:35px;
line-height:1.5;
}

.subtitle{
font-size:17px;
}

.underline{
width:180px;
margin:12px auto 20px;
}

.form-card{
width:100%;
padding:20px 13px;
border-radius:25px;
}

label{
font-size:20px;
}

.name{
height:55px;
font-size:16px;
}

.choice-title{
font-size:21px;
}

.choices{
gap:9px;
}

.choice{
min-height:70px;
font-size:19px;
border-radius:20px;
}

.choice .emoji{
font-size:27px;
}

.choice .circle{
width:23px;
height:23px;
font-size:14px;
}

.send{
height:62px;
font-size:18px;
}

.hint{
font-size:12px;
}

.question{
top:100px;
font-size:60px;
}

.question.blue{left:2%}
.question.pink{right:2%}

.doodle{
font-size:35px;
}

.heart-left{left:10%;top:26%}
.heart-right{right:10%;top:26%}
.crown-left{left:12%;top:21%}
.crown-right{right:12%;top:21%}

.corner-symbol{
bottom:110px;
font-size:55px;
width:65px;
}

.boy-symbol{left:2%}
.girl-symbol{right:2%}

.cloud-bank{
height:85px;
}

.cloud{
transform:scale(.7);
}

.results{
padding:12px;
}

.results-box{
padding:15px;
margin:10px auto;
}

.results h2{
font-size:26px;
}

.stats{
gap:6px;
}

.stat{
padding:8px 3px;
font-size:12px;
}

.stat strong{
font-size:23px;
}

.vote{
font-size:14px;
}
}

/* شاشات الجوال الصغيرة */
@media screen and (max-width:360px){
h1{font-size:30px}
.choice{font-size:16px}
.choice .emoji{font-size:23px}
.question{font-size:48px}
.form-card{padding:17px 10px}
}
</style>
</head>

<body>

<div class="scene" id="home">

<div class="stars"></div>

<header>
<div class="logo">👣</div>
<nav>
<button onclick="showResults()">🎁 النتائج</button>
</nav>
</header>

<div class="question blue">؟</div>
<div class="question pink">؟</div>

<div class="doodle blue heart-left">♡</div>
<div class="doodle pink heart-right">♡</div>
<div class="doodle blue crown-left">♛</div>
<div class="doodle pink crown-right">♛</div>

<main class="hero">

<h1>توقع جنس المولود</h1>
<p class="subtitle">وش تتوقع؟ ولد ولا بنت؟</p>
<div class="underline"></div>

<section class="form-card">

<label for="visitorName">اسمك الكريم　👤</label>

<input
id="visitorName"
class="name"
type="text"
maxlength="32"
placeholder="أدخل اسمك هنا..."
autocomplete="name"
>

<h2 class="choice-title">توقعك ✨</h2>

<div class="choices">

<button class="choice girl" id="girlBtn" onclick="choose('بنت')">
<span class="emoji">👧🏻</span> بنت
<span class="circle"></span>
</button>

<button class="choice boy" id="boyBtn" onclick="choose('ولد')">
<span class="emoji">👦🏻</span> ولد
<span class="circle"></span>
</button>

</div>

<button class="send" onclick="submitVote()">
إرسال توقعك　➤
</button>

<p class="hint">♡ شاركنا توقعك واستمتع بالفعالية</p>

</section>
</main>

<div class="corner-symbol boy-symbol">💙</div>
<div class="corner-symbol girl-symbol">🎀</div>

<div class="cloud left"></div>
<div class="cloud right"></div>
<div class="cloud-bank"></div>

</div>

<!-- صفحة النتائج -->
<section class="results" id="results">

<div class="results-box">

<button class="back" onclick="showHome()">
← العودة للرئيسية
</button>

<h2>🎁 نتائج التوقعات</h2>

<div class="stats">

<div class="stat" style="color:#8ec6ff">
💙 ولد
<strong id="boysCount">0</strong>
</div>

<div class="stat" style="color:#f3a0d5">
💗 بنت
<strong id="girlsCount">0</strong>
</div>

<div class="stat">
✨ الإجمالي
<strong id="totalCount">0</strong>
</div>

</div>

<h3>أسماء المشاركين</h3>
<div class="list" id="votesList"></div>

</div>
</section>

<div class="toast" id="toast"></div>

<script>

let selectedGender="";

const STORAGE_KEY="babyGenderVotes";

function readVotes(){
try{
const data=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");
return Array.isArray(data)?data:[];
}catch{
return [];
}
}

/* اختيار ولد أو بنت */
function choose(gender){

selectedGender=gender;

const boyBtn=document.getElementById("boyBtn");
const girlBtn=document.getElementById("girlBtn");

boyBtn.classList.remove("selected");
girlBtn.classList.remove("selected");

if(gender==="ولد"){
boyBtn.classList.add("selected");
}else{
girlBtn.classList.add("selected");
}

}

function showMessage(message){

const toast=document.getElementById("toast");

toast.textContent=message;
toast.style.display="block";

clearTimeout(showMessage.timer);

showMessage.timer=setTimeout(()=>{
toast.style.display="none";
},3000);

}

function submitVote(){

const name=document.getElementById("visitorName").value.trim();

if(!name){
showMessage("اكتب اسمك أولاً 💗");
return;
}

if(!selectedGender){
showMessage("اختر ولد أو بنت أولاً 💙💗");
return;
}

const votes=readVotes();

votes.push({
name,
gender:selectedGender,
date:Date.now()
});

try{
localStorage.setItem(STORAGE_KEY,JSON.stringify(votes));
}catch{
showMessage("تعذر حفظ التوقع على هذا الجهاز");
return;
}

document.getElementById("visitorName").value="";

selectedGender="";

document.getElementById("boyBtn").classList.remove("selected");
document.getElementById("girlBtn").classList.remove("selected");

showMessage("تم تسجيل توقعك بنجاح 🎉");

}

function showResults(){

document.getElementById("home").style.display="none";
document.getElementById("results").style.display="block";

const votes=readVotes();

const boys=votes.filter(v=>v.gender==="ولد").length;
const girls=votes.filter(v=>v.gender==="بنت").length;

document.getElementById("boysCount").textContent=boys;
document.getElementById("girlsCount").textContent=girls;
document.getElementById("totalCount").textContent=votes.length;

const list=document.getElementById("votesList");

list.replaceChildren();

if(votes.length===0){

const empty=document.createElement("p");

empty.className="empty";
empty.textContent="ما فيه توقعات للحين، كن أول مشارك! 💕";

list.appendChild(empty);

return;
}

[...votes].reverse().forEach(vote=>{

const row=document.createElement("div");
row.className="vote";

const name=document.createElement("span");
name.textContent=vote.name;

const gender=document.createElement("strong");

gender.textContent=
vote.gender==="ولد"?"💙 ولد":"🎀 بنت";

row.append(name,gender);

list.appendChild(row);

});

}

function showHome(){

document.getElementById("home").style.display="block";
document.getElementById("results").style.display="none";

}

</script>

</body>
</html>
